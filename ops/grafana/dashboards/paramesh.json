        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "refId": "A",
          "expr": "paramesh_pending_workers{job=\"shards\"}",
          "legendFormat": "{{component}} {{method}} {{worker_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
